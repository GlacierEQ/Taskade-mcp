# Taskade MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# Your Taskade Personal API Key
# Get it from: Taskade Settings > API > Personal API Key
# Format: tskdp_...
TASKADE_API_KEY=

# Taskade API Base URL (do not change unless self-hosting)
TASKADE_API_BASE_URL=https://www.taskade.com/api/v1
